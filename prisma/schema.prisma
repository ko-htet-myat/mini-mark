generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  shop          Shop?

  reviewedRequests       SubscriptionRequest[] @relation("SubscriptionRequestReviewedBy")
  recordedPayments       PaymentRecord[]       @relation("PaymentRecordRecordedBy")
  activatedSubscriptions Subscription[]        @relation("SubscriptionActivatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Currency {
  USD
  MMK
  JPY
  KRW
  THB
}

model Shop {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  description          String?
  logoUrl              String?
  bannerUrl            String?
  contactEmail         String?
  currency             Currency              @default(MMK)
  contactPhones        String[]              @default([])
  ownerId              String                @unique
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categories           Category[]
  brands               Brand[]
  products             Product[]
  attributes           Attribute[]
  promotions           Promotion[]
  subscription         Subscription?
  subscriptionRequests SubscriptionRequest[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([parentId])
  @@map("category")
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  logoUrl     String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("brand")
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  sku            String?
  stock          Int           @default(0)
  status         ProductStatus @default(IN_STOCK)
  images         String[]      @default([])
  youtubeUrl     String?
  isActive       Boolean       @default(true)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  attributeValues ProductAttributeValue[]
  promotions      Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId, isActive, categoryId])
  @@index([shopId, isActive, brandId])
  @@index([shopId])
  @@index([categoryId])
  @@index([brandId])
  @@map("product")
}

model Attribute {
  id   String @id @default(cuid())
  name String
  slug String

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("attribute")
}

model AttributeValue {
  id    String @id @default(cuid())
  value String

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  products ProductAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_value")
}

model ProductAttributeValue {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  extraPrice Decimal? @db.Decimal(10, 2)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attribute_value")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id            String       @id @default(cuid())
  name          String
  slug          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  code          String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Optional targeting — empty means shop-wide
  products   Product[]
  categories Category[]
  brands     Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@unique([shopId, code])
  @@index([shopId])
  @@map("promotion")
}

// subscription

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id           String          @id @default(cuid())
  name         String // "Starter", "Growth", "Pro"
  slug         String          @unique
  description  String?
  interval     BillingInterval
  price        Decimal         @db.Decimal(10, 2)
  currency     String          @default("USD")
  productLimit Int? // null = unlimited
  orderLimit   Int? // null = unlimited, per billing period
  isActive     Boolean         @default(true) // can hide old plans w/o deleting

  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
  PENDING_ACTIVATION // request approved, awaiting payment confirmation
}

model Subscription {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  autoRenew        Boolean            @default(false)
  notes            String?

  activatedById String?
  activatedBy   User?     @relation("SubscriptionActivatedBy", fields: [activatedById], references: [id])
  activatedAt   DateTime?

  payments PaymentRecord[]
  requests SubscriptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscription")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A shop owner's "I want to upgrade" request — this is the manual-sales-contact step
model SubscriptionRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  status         RequestStatus @default(PENDING)
  contactPhone   String?
  contactMessage String?

  reviewedById    String?
  reviewedBy      User?     @relation("SubscriptionRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@map("subscription_request")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_MONEY
  OTHER
}

// Manual bookkeeping — replaces what Stripe's invoice history would normally give you
model PaymentRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("USD")
  method     PaymentMethod
  reference  String?
  receiptUrl String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordRecordedBy", fields: [recordedById], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@map("payment_record")
}
