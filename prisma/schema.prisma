generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  shop          Shop?

  reviewedRequests       SubscriptionRequest[] @relation("SubscriptionRequestReviewedBy")
  recordedPayments       PaymentRecord[]       @relation("PaymentRecordRecordedBy")
  activatedSubscriptions Subscription[]        @relation("SubscriptionActivatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Currency {
  USD
  MMK
  JPY
  KRW
  THB
}

enum ShopCategoryType {
  RESTAURANT
  RETAIL
  ELECTRONICS
  FASHION
  GROCERY
  LIQUOR_STORE
  BEAUTY
  HEALTH
  HOME_GARDEN
  SPORTS
  BOOKS_STATIONERY
  AUTOMOTIVE
  SERVICES
  OTHER
}

model Shop {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  description          String?
  logoUrl              String?
  bannerUrl            String?
  contactEmail         String?
  currency             Currency              @default(MMK)
  contactPhones        String[]              @default([])
  shopCategory         ShopCategoryType
  ownerId              String                @unique
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categories           Category[]
  brands               Brand[]
  products             Product[]
  attributes           Attribute[]
  promotions           Promotion[]
  subscription         Subscription?
  subscriptionRequests SubscriptionRequest[]
  orders               Order[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([parentId])
  @@map("category")
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  logoUrl     String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("brand")
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  price          Decimal  @db.Decimal(10, 2) // base/"from" price
  compareAtPrice Decimal? @db.Decimal(10, 2)
  imageUrl       String?
  youtubeUrl     String?
  isActive       Boolean  @default(true)
  hasVariants    Boolean  @default(false) // 👈 new: drives simple-vs-variant UI branch
  // ⛔ removed: sku, stock, status — now on ProductVariant

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  variants   ProductVariant[] // 👈 replaces attributeValues
  promotions Promotion[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@unique([shopId, slug])
  @@index([shopId, isActive, categoryId])
  @@index([shopId, isActive, brandId])
  @@index([shopId])
  @@index([categoryId])
  @@index([brandId])
  @@map("product")
}

model Attribute {
  id   String @id @default(cuid())
  name String
  slug String

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("attribute")
}

model AttributeValue {
  id    String @id @default(cuid())
  value String

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variants ProductVariantAttributeValue[] // ✅ matches ProductVariantAttributeValue.attributeValue field

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_value")
}

model ProductVariant {
  id             String        @id @default(cuid())
  sku            String?
  price          Decimal?      @db.Decimal(10, 2) // null = inherit Product.price
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  stock          Int           @default(0)
  status         ProductStatus @default(IN_STOCK)
  imageUrl       String?
  isActive       Boolean       @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeValues ProductVariantAttributeValue[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([productId])
  @@index([status])
  @@map("product_variant")
}

model ProductVariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variant_attribute_value")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id            String       @id @default(cuid())
  name          String
  slug          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  code          String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Optional targeting — empty means shop-wide
  products   Product[]
  categories Category[]
  brands     Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([shopId, slug])
  @@unique([shopId, code])
  @@index([shopId])
  @@map("promotion")
}

// subscription

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id           String          @id @default(cuid())
  name         String // "Starter", "Growth", "Pro"
  slug         String          @unique
  description  String?
  interval     BillingInterval
  price        Decimal         @db.Decimal(10, 2)
  currency     String          @default("USD")
  productLimit Int? // null = unlimited
  orderLimit   Int? // null = unlimited, per billing period
  isActive     Boolean         @default(true) // can hide old plans w/o deleting

  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
  PENDING_ACTIVATION // request approved, awaiting payment confirmation
}

model Subscription {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  autoRenew        Boolean            @default(false)
  notes            String?

  activatedById String?
  activatedBy   User?     @relation("SubscriptionActivatedBy", fields: [activatedById], references: [id])
  activatedAt   DateTime?

  payments PaymentRecord[]
  requests SubscriptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscription")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A shop owner's "I want to upgrade" request — this is the manual-sales-contact step
model SubscriptionRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  status         RequestStatus @default(PENDING)
  contactPhone   String?
  contactMessage String?

  reviewedById    String?
  reviewedBy      User?     @relation("SubscriptionRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@map("subscription_request")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_MONEY
  OTHER
}

// Manual bookkeeping — replaces what Stripe's invoice history would normally give you
model PaymentRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("USD")
  method     PaymentMethod
  reference  String?
  receiptUrl String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordRecordedBy", fields: [recordedById], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@map("payment_record")
}

// order flow
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String // human-readable, e.g. "ORD-0001"

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?
  currency      Currency       @default(MMK)

  // guest checkout — no Customer model
  customerName  String
  customerPhone String
  customerEmail String?

  shippingAddress String?
  shippingCity    String?
  note            String?

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  items   OrderItem[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, orderNumber])
  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@map("order")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // snapshots — protect historical orders from later catalog edits
  productName  String
  variantLabel String? // e.g. "Red / L"
  sku          String?
  price        Decimal @db.Decimal(10, 2) // unit price at time of order
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2) // price * quantity

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, invoiceNumber])
  @@map("invoice")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

enum AuditAction {
  // Subscription request lifecycle
  SUBSCRIPTION_REQUEST_APPROVED
  SUBSCRIPTION_REQUEST_REJECTED
  // Payment bookkeeping
  PAYMENT_RECORDED
  // Subscription lifecycle
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRED
  // Shop management
  SHOP_CREATED
  SHOP_UPDATED
  SHOP_DELETED
}

enum AuditEntityType {
  SUBSCRIPTION_REQUEST
  PAYMENT_RECORD
  SUBSCRIPTION
  SHOP
}

/// Append-only event log — never update or delete rows.
/// No FK to User or Shop so logs survive deletions.
/// actorName is snapshotted at write time.
model AuditLog {
  id         String          @id @default(cuid())
  actorId    String // user who performed the action
  actorName  String // snapshot of user.name at write time
  action     AuditAction
  entityType AuditEntityType
  entityId   String // PK of the affected record
  shopId     String? // null for platform-level actions
  metadata   Json? // typed payload per action, stored as JSON

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([shopId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
